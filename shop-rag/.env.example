APP_NAME=shop-rag
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

QDRANT_URL=http://127.0.0.1:6333
# After importing the included ICBC chunks, use: icbc_procedures
QDRANT_COLLECTION=
QDRANT_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
ANSWER_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=30m

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

STAFF_ACCESS_MODE=open
DEFAULT_TOP_K=6
MAX_CONTEXT_CHUNKS=3
MIN_SCORE_THRESHOLD=0.25
KEYWORD_FALLBACK_SCAN_LIMIT=2500
# After importing with scripts/import_chunks_to_qdrant.py, use: all-MiniLM-L6-v2
QUERY_EMBEDDING_MODEL=
ENABLE_LOCAL_CHUNKS_FALLBACK=true
LOCAL_CHUNKS_PATH=../output/chunks.jsonl
SHOP_DOCS_INBOX_PATH=data/shop_docs/inbox

LOG_LEVEL=INFO
